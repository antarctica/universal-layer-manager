{
  "name": "@ulm/leaflet",
  "type": "module",
  "version": "1.0.0",
  "description": "Leaflet adapter for @ulm/core",
  "author": {
    "name": "Jonathan Dawe",
    "email": "jonwe@bas.ac.uk"
  },
  "exports": {
    ".": {
      "import": "./dist/leaflet.js",
      "require": "./dist/leaflet.cjs"
    }
  },
  "main": "./dist/leaflet.cjs",
  "module": "./dist/leaflet.js",
  "types": "./dist/leaflet.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest --run",
    "check-types": "tsc --noemit -p tsconfig.json"
  },
  "peerDependencies": {
    "@ulm/core": "*",
    "leaflet": "^1.9.4"
  },
  "dependencies": {
    "@ulm/core": "*"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "camelcase": "^9.0.0",
    "leaflet": "^1.9.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1",
    "xstate": "^5.33.2"
  }
}
