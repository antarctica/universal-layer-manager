{
  "name": "@ulm/core",
  "type": "module",
  "version": "3.1.1",
  "description": "A universal layer manager for map applications",
  "author": {
    "name": "Jonathan Dawe",
    "email": "jonwe@bas.ac.uk"
  },
  "homepage": "https://github.com/antarctica/universal-layer-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antarctica/universal-layer-manager.git"
  },
  "bugs": {
    "url": "https://github.com/antarctica/universal-layer-manager/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    }
  },
  "main": "./dist/core.cjs",
  "module": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "release": "npm run build && npm publish",
    "check-types": "tsc --noemit -p tsconfig.json"
  },
  "dependencies": {
    "temporal-spec": "^1.0.1",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "camelcase": "^9.0.0",
    "temporal-polyfill": "^1.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1"
  }
}
