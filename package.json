{
  "name": "universal-layer-manager-monorepo",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "^22.22.1 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --fix",
    "lint:turbo": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "prepare": "husky install",
    "changelog:preview": "git-cliff --unreleased --bump",
    "changelog:draft": "git-cliff --unreleased --bump --prepend CHANGELOG.md",
    "changelog:range": "git-cliff",
    "version:next": "git-cliff --bumped-version",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-react/eslint-plugin": "^5.20.8",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "mermaid": "^11.17.2",
    "turbo": "^2.11.3",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix"
  }
}
